def find_editable_text(wechat_app):
    """精准筛选：角色=text + 状态=可编辑+可聚焦+敏感"""
    candidates = []
    
    def scan(obj, depth=0):
        if depth > 12:  # 安全深度限制
            return
        try:
            role = obj.getRoleName()
            states = obj.getState()
            
            # 核心条件：text + 可编辑 + 可聚焦（排除只读文本）
            if (role == "text" and 
                states.contains(pyatspi.STATE_EDITABLE) and
                states.contains(pyatspi.STATE_FOCUSABLE) and
                states.contains(pyatspi.STATE_SENSITIVE)):
                # 进阶过滤：排除搜索框（微信搜索框通常有"搜索"字样）
                if "搜索" not in (obj.name or "").lower():
                    candidates.append(obj)
            
            for i in range(obj.childCount):
                scan(obj.getChildAtIndex(i), depth+1)
        except:
            pass
    
    scan(wechat_app)
    
    # 优先返回当前聚焦的输入框（最可能是聊天输入框）
    for obj in candidates:
        if obj.getState().contains(pyatspi.STATE_FOCUSED):
            return obj
    return candidates[0] if candidates else None

    ✅ 优势：

        无需知道父级结构，单函数搞定
        自动排除搜索框/备注框等干扰项
        聚焦状态优先，精准命中当前聊天输入框

