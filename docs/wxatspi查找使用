def find_wechat_control_fallback(self, control_type):
    """
    容错定位：优先按文本/角色，depth 仅作为兜底
    :param control_type: input_box/send_button/chat_display
    """
    fallback_rules = {
        "input_box": {
            "primary": {"role": "text box", "editable": True},
            "fallback": {"depth": 7, "role": "text box"}  # 旧版本depth
        },
        "send_button": {
            "primary": {"role": "button", "target_text": "发送"},
            "fallback": {"depth": 6, "role": "button"}
        },
        "chat_display": {
            "primary": {"role": "list item", "parent_role": "scroll pane"},
            "fallback": {"depth": 14, "role": "list item"}
        }
    }
    rule = fallback_rules[control_type]
    # 优先按主规则查找
    result = self.find_text_control(**rule["primary"])
    if not result:
        # 兜底按depth查找
        result = self.find_text_control(**rule["fallback"])
    return result

