def find_chat_input_by_send_btn(wechat_app):
    """
    通过「发送按钮」反向定位输入框（微信 UI 结构最稳定关系）
    原理：输入框与发送按钮同属一个容器（panel），且输入框在按钮前
    """
    # 1. 定位发送按钮（名称稳定）
    send_btn = find_element(
        wechat_app,
        role="push button",
        name_contains=["发送", "Send"]  # 多语言兼容
    )
    if not send_btn:
        return None
    
    # 2. 获取共同父容器（关键！）
    container = send_btn.parent
    if not container:
        return None
    
    # 3. 在容器内找可编辑 text（精准过滤）
    for i in range(container.childCount):
        child = container.getChildAtIndex(i)
        if (child.getRoleName() == "text" and 
            child.getState().contains(pyatspi.STATE_EDITABLE)):
            return child  # ✅ 找到输入框！
    return None

