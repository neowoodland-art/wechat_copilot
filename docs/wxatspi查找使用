🧪 二、特征定位引擎（lib/feature_locator.py）
python

import pyatspi
import yaml
from typing import List, Dict, Optional

class FeatureLocator:
    def __init__(self, wechat_root):
        self.root = wechat_root
        self.codes = self._load_feature_codes()
        self.cache = {}  # 缓存: {feature_code: [widgets]}
    
    def _load_feature_codes(self):
        with open("config/feature_codes.yaml") as f:
            return yaml.safe_load(f)["atomic_widgets"]
    
    def find_single(self, code: str) -> Optional[pyatspi.Accessible]:
        """定位单个控件（如发送按钮）"""
        if code in self.cache and len(self.cache[code]) > 0:
            return self.cache[code][0]
        
        config = self.codes[code]
        widget = self._scan_with_features(config["features"])
        if widget:
            self.cache[code] = [widget]
        return widget
    
    def find_multiple(self, code: str, container_code: Optional[str] = None) -> List[pyatspi.Accessible]:
        """
        定位多个控件（核心！解决"同一深度一串内容"问题）
        :param code: 原子控件特征码（如"14LI01M"）
        :param container_code: 容器特征码（如聊天区域容器）
        """
        cache_key = f"{container_code or 'root'}_{code}"
        if cache_key in self.cache:
            return self.cache[cache_key]
        
        # 1. 先定位容器（如有）
        search_root = self.root
        if container_code:
            container_config = self.codes.get(container_code)
            if container_config:
                search_root = self._scan_with_features(container_config["features"])
                if not search_root:
                    return []
        
        # 2. 在容器内扫描所有匹配项
        config = self.codes[code]
        widgets = self._scan_all_with_features(search_root, config["features"])
        
        # 3. 按序号排序（微信聊天记录按创建时间排序）
        widgets.sort(key=lambda w: self._get_index_in_parent(w))
        self.cache[cache_key] = widgets
        return widgets
    
    def _scan_with_features(self, features: Dict) -> Optional[pyatspi.Accessible]:
        """单控件扫描（带深度优化）"""
        max_depth = features.get("depth", 20)
        return self._dfs_scan(self.root, features, current_depth=0, max_depth=max_depth)
    
    def _scan_all_with_features(self, root, features: Dict) -> List[pyatspi.Accessible]:
        """多控件扫描（容器内全量扫描）"""
        results = []
        self._dfs_collect(root, features, results)
        return results
    
    def _dfs_scan(self, obj, features, current_depth, max_depth) -> Optional[pyatspi.Accessible]:
        """深度优先搜索（单结果）"""
        if current_depth > max_depth:
            return None
        
        if self._matches_features(obj, features):
            return obj
        
        for i in range(obj.childCount):
            child = obj.getChildAtIndex(i)
            result = self._dfs_scan(child, features, current_depth+1, max_depth)
            if result:
                return result
        return None
    
    def _dfs_collect(self, obj, features, results):
        """深度优先收集（多结果）"""
        if self._matches_features(obj, features):
            results.append(obj)
        
        # 仅扫描直接子节点（避免递归过深，微信容器结构扁平）
        for i in range(min(50, obj.childCount)):  # 限制子节点数防卡死
            child = obj.getChildAtIndex(i)
            self._dfs_collect(child, features, results)
    
    def _matches_features(self, obj, features) -> bool:
        """特征匹配核心逻辑"""
        # 角色匹配
        if features.get("role") and obj.getRoleName() != features["role"]:
            return False
        
        # 状态匹配
        if features.get("required_states"):
            state_set = obj.getState()
            for state_name in features["required_states"]:
                if not state_set.contains(getattr(pyatspi, f"STATE_{state_name.upper()}")):
                    return False
        
        # 名称匹配（支持contains/regex）
        if features.get("name_contains"):
            name = obj.name or ""
            if not any(substr in name for substr in features["name_contains"]):
                return False
        
        # 子控件特征匹配（用于语音消息识别）
        if features.get("has_child"):
            found = False
            for i in range(obj.childCount):
                child = obj.getChildAtIndex(i)
                if self._matches_features(child, features["has_child"]):
                    found = True
                    break
            if not found:
                return False
        
        return True
    
    def _get_index_in_parent(self, obj) -> int:
        """获取控件在父容器中的序号（用于排序）"""
        parent = obj.parent
        if not parent:
            return 0
        for i in range(parent.childCount):
            if parent.getChildAtIndex(i) == obj:
                return i
        return 0

