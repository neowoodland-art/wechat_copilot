（1）「先过滤再遍历」：按角色 / 状态缩小范围
python
运行

import pyatspi
import time

class WeChatATSPILocator:
    def __init__(self):
        # 定位微信主窗口（Arch 下用窗口名过滤，避免找错窗口）
        self.wechat_window = self._get_wechat_window()

    def _get_wechat_window(self):
        """Arch 下精准定位微信窗口（避免多窗口干扰）"""
        desktop = pyatspi.get_desktop()
        for child in desktop:
            # 匹配微信窗口名（不同版本可能是"微信"或"WeChat"）
            if "微信" in child.name or "WeChat" in child.name:
                return child
        return None

    def find_text_control(self, target_text=None, role=None, editable=False):
        """
        精准查找文本控件
        :param target_text: 控件文本（如"发送"）
        :param role: 控件角色（如"text box"）
        :param editable: 是否可编辑（输入框=True）
        """
        matched_controls = []
        # 递归遍历，但先过滤角色/状态，减少遍历节点
        def traverse(node, current_depth):
            # 跳过不可见/不可用的控件（微信大量隐藏节点）
            if not node.get_state().contains(pyatspi.STATE_SHOWING):
                return
            # 过滤角色
            if role and node.get_role_name() != role:
                return
            # 过滤可编辑状态（输入框专用）
            if editable and not node.get_state().contains(pyatspi.STATE_EDITABLE):
                return
            # 匹配文本内容（支持模糊匹配，应对微信文本带空格/数字）
            if target_text and target_text in node.name:
                matched_controls.append({
                    "control": node,
                    "depth": current_depth,
                    "name": node.name,
                    "position": (node.get_position().x, node.get_position().y),
                    "parent_role": node.parent.get_role_name() if node.parent else None
                })
            # 只遍历到深度20（微信控件树最大深度约20，避免无限递归）
            if current_depth < 20:
                for child in node:
                    traverse(child, current_depth + 1)

        traverse(self.wechat_window, 0)
        return matched_controls

（2）「缓存控件树」：高频查询时避免重复遍历
微信控件树短时间内不会变化，缓存结果可提升效率 5-10 倍：
