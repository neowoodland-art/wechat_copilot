python

class ContentExtractor:
    @staticmethod
    def extract_contact_item(widget) -> Dict:
        """提取联系人信息（调用feature_codes.yaml中定义的parser）"""
        name_str = widget.name or ""
        parts = name_str.split(' ', 1)
        return {
            "name": parts[0],
            "unread_count": int(parts[1]) if len(parts) > 1 and parts[1].isdigit() else 0,
            "raw": name_str
        }
    
    @staticmethod
    def extract_message_content(widget) -> Dict:
        """
        提取聊天消息完整内容（递归子控件文本）
        微信消息结构：list item → [image(头像), text(昵称), text(内容), text(时间)]
        """
        content_parts = []
        sender = None
        timestamp = None
        
        def traverse(obj, depth=0):
            nonlocal sender, timestamp
            if depth > 3:  # 限制深度
                return
            
            # 提取文本节点
            if obj.getRoleName() == "text" and obj.name:
                text = obj.name.strip()
                if text:
                    # 启发式判断：短文本+非时间格式 → 消息内容
                    if len(text) > 2 and not ContentExtractor._is_timestamp(text):
                        content_parts.append(text)
                    # 尝试识别发送者（通常在消息前）
                    elif not sender and len(text) <= 8 and not text.isdigit():
                        sender = text
            
            # 递归子节点
            for i in range(min(10, obj.childCount)):
                traverse(obj.getChildAtIndex(i), depth+1)
        
        traverse(widget)
        
        return {
            "sender": sender,
            "content": " ".join(content_parts),
            "timestamp": timestamp,
            "is_self": "我" in (sender or ""),  # 简易判断（需优化）
            "raw_widget": widget  # 保留widget供后续操作（如点击语音）
        }
    
    @staticmethod
    def _is_timestamp(text: str) -> bool:
        """简易时间格式识别"""
        time_patterns = [
            r"\d{1,2}:\d{2}",  # 10:30
            r"上午 \d{1,2}:\d{2}",
            r"昨天 \d{1,2}:\d{2}",
            r"\d{1,2}/\d{1,2}"  # 6/15
        ]
        return any(re.search(p, text) for p in time_patterns)

