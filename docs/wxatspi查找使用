def __init__(self):
    self.wechat_window = self._get_wechat_window()
    self.control_tree_cache = None  # 控件树缓存
    self.cache_expire_time = 5  # 缓存5秒过期（适配微信界面变化）

def _get_control_tree_cache(self):
    """获取缓存的控件树，过期自动刷新"""
    now = time.time()
    if (self.control_tree_cache is None) or (now - self.control_tree_cache["time"] > self.cache_expire_time):
        # 预遍历所有可见控件，存入缓存
        tree = []
        def collect(node, depth):
            if node.get_state().contains(pyatspi.STATE_SHOWING):
                tree.append({
                    "control": node,
                    "depth": depth,
                    "role": node.get_role_name(),
                    "name": node.name,
                    "editable": node.get_state().contains(pyatspi.STATE_EDITABLE)
                })
                if depth < 20:
                    for child in node:
                        collect(child, depth + 1)
        collect(self.wechat_window, 0)
        self.control_tree_cache = {"tree": tree, "time": now}
    return self.control_tree_cache["tree"]

# 优化后的查找方法（从缓存查）
def find_text_control_from_cache(self, target_text=None, role=None):
    tree = self._get_control_tree_cache()
    return [item for item in tree if 
            (not target_text or target_text in item["name"]) and 
            (not role or item["role"] == role)]

