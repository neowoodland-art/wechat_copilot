def get(self, name, force_refresh=False):
    if name in self.cache and not force_refresh:
        return self.cache[name]
    
    config = self.locators[name]
    
    # 智能路由：根据 strategy 选择定位算法
    if config["strategy"] == "relative":
        element = self._locate_by_relative(config)
    elif config["strategy"] == "state_combo":
        element = self._locate_by_states(config)
    else:
        element = self._scan_locator(config)  # 传统深度扫描（兜底）
    
    if element:
        self.cache[name] = element
        # 验证：确保是真正的输入框
        if not self._verify_text_input(element):
            self.cache.pop(name, None)
            raise Exception(f"定位失败：{name} 不是有效输入框")
    return element

def _verify_text_input(self, obj):
    """严格验证：必须是可编辑文本框"""
    if obj.getRoleName() != "text":
        return False
    states = obj.getState()
    return (states.contains(pyatspi.STATE_EDITABLE) and
            states.contains(pyatspi.STATE_FOCUSABLE))



