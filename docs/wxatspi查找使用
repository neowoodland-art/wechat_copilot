python

import os
import time
import subprocess
from pathlib import Path

class VoiceProcessor:
    # 微信语音默认保存路径（ArchLinux）
    DEFAULT_SAVE_PATH = Path.home() / "Documents/WeChat Files/"
    
    @staticmethod
    def process_voice_message(locator, message_widget, save_dir=None):
        """
        完整流水线：点击语音 → 保存 → 转文本
        :param message_widget: 语音消息控件（feature_locator.find_multiple返回的widget）
        :return: 转换后的文本 or None
        """
        # 1. 点击语音消息（触发播放/菜单）
        message_widget.click()
        time.sleep(0.5)
        
        # 2. 定位"保存"按钮（右键菜单或长按菜单）
        save_btn = locator.find_single("save_voice_button")  # 需在feature_codes.yaml定义
        if not save_btn:
            # 备用：模拟右键+保存（需配置）
            VoiceProcessor._simulate_save_via_menu()
        
        save_btn.click()
        time.sleep(1.0)  # 等待保存完成
        
        # 3. 监控文件生成（微信保存后文件名含时间戳）
        latest_file = VoiceProcessor._find_latest_voice_file(save_dir or VoiceProcessor.DEFAULT_SAVE_PATH)
        if not latest_file:
            raise Exception("未检测到保存的语音文件")
        
        # 4. 调用语音转文本服务（Whisper示例）
        text = VoiceProcessor._transcribe_with_whisper(latest_file)
        return text
    
    @staticmethod
    def _find_latest_voice_file(save_path: Path, timeout=5) -> Optional[Path]:
        """监控目录，返回最新.amr/.mp3文件"""
        start_time = time.time()
        while time.time() - start_time < timeout:
            voice_files = sorted(
                [f for f in save_path.glob("*.amr")] + [f for f in save_path.glob("*.mp3")],
                key=lambda f: f.stat().st_mtime,
                reverse=True
            )
            if voice_files:
                return voice_files[0]
            time.sleep(0.3)
        return None
    
    @staticmethod
    def _transcribe_with_whisper(audio_path: Path) -> str:
        """调用Whisper（需预装）"""
        try:
            result = subprocess.run(
                ["whisper", str(audio_path), "--language", "zh", "--model", "base"],
                capture_output=True,
                text=True,
                timeout=30
            )
            # 解析Whisper输出（简化版）
            if result.returncode == 0:
                # 提取转录文本（实际需解析JSON输出）
                return result.stdout.split("]")[-1].strip()
        except Exception as e:
            print(f"Whisper转录失败: {e}")
        return ""

